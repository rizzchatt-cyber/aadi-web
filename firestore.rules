rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Products, Categories, and Banners: Read-only for public, write-only for Admin
    match /products/{docId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.email in ['aadityas.aura.web@gmail.com', 'adityas.aura.web@gmail.com', 'aadityasaura@gmail.com', 'laksxhya@gmail.com']);
    }
    
    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.email in ['aadityas.aura.web@gmail.com', 'adityas.aura.web@gmail.com', 'aadityasaura@gmail.com', 'laksxhya@gmail.com']);
    }
    
    match /banners/{docId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.email in ['aadityas.aura.web@gmail.com', 'adityas.aura.web@gmail.com', 'aadityasaura@gmail.com', 'laksxhya@gmail.com']);
    }
    
    // User profile records: read/write by owner and admin
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email in ['aadityas.aura.web@gmail.com', 'adityas.aura.web@gmail.com', 'aadityasaura@gmail.com', 'laksxhya@gmail.com']);
    }
    
    // Carts: read/write by owner and admin
    match /carts/{cartId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid || request.auth.token.email in ['aadityas.aura.web@gmail.com', 'adityas.aura.web@gmail.com', 'aadityasaura@gmail.com', 'laksxhya@gmail.com']);
    }
    
    // Orders: anyone can place an order (allowing guest checkout), but reading is restricted to owner & admin
    match /orders/{orderId} {
      // Allow guests and logged-in users to place (create) orders
      allow create: if true;
      
      // Allow reading order details only to the owner of the order or store admins
      allow read: if (request.auth != null && (
        resource.data.userId == request.auth.uid || 
        request.auth.token.email in ['aadityas.aura.web@gmail.com', 'adityas.aura.web@gmail.com', 'aadityasaura@gmail.com', 'laksxhya@gmail.com']
      ));
      
      // Allow updating orders (changing status) and deletion only to store admins
      allow update, delete: if request.auth != null && (request.auth.token.email in ['aadityas.aura.web@gmail.com', 'adityas.aura.web@gmail.com', 'aadityasaura@gmail.com', 'laksxhya@gmail.com']);
    }
  }
}
